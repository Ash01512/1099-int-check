{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1099-int-check",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",

  // Static assets are served by the runtime; the Worker in src/index.js
  // wraps them to attach security headers and handles POST /api/signup.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // This is a one-page site, not an SPA. With single-page-application
    // every unknown path returned the landing page with a 200, so
    // crawlers would see unlimited duplicate URLs. "none" lets unknown
    // paths 404 honestly.
    "not_found_handling": "none",

    // Without this, matching assets are served straight from the asset
    // store and the Worker never runs — which silently drops every
    // security header on the page itself. Verified: with this false,
    // GET / returns no CSP at all.
    "run_worker_first": true
  },

  // The project URL is not a secret; it ships in every Supabase client.
  // SUPABASE_PUBLISHABLE_KEY is set as a secret instead, so a public repo
  // does not hand strangers a way to POST straight into the table and
  // bypass this Worker's validation and honeypot:
  //   npx wrangler secret put SUPABASE_PUBLISHABLE_KEY
  "vars": {
    "SUPABASE_URL": "https://dorpekyszdlhvcozuocj.supabase.co",

    // Walkthrough delivery. RESEND_API_KEY is a secret, set separately:
    //   npx wrangler secret put RESEND_API_KEY
    //
    // WALKTHROUGH_FROM must be an address on a DOMAIN YOU HAVE VERIFIED in
    // Resend. Until a domain is verified, Resend only permits sending from
    // onboarding@resend.dev and only TO the address you signed up with. That
    // sandbox is fine for reading the email yourself; it cannot reach a single
    // real reader. /api/status reports sandbox:true so this is never mistaken
    // for working delivery.
    "WALKTHROUGH_FROM": "onboarding@resend.dev",

    // Optional. A blind copy of every walkthrough, so your inbox is the
    // delivery log and you see exactly what each reader sees.
    "FOUNDER_BCC": ""
  },

  // Per-IP throttle on /api/signup. Without this the endpoint is an open
  // write into the database: the honeypot stops naive bots, but nothing
  // stopped a script from filling the table. 5 per minute is generous for
  // a human and useless for a flood.
  "ratelimits": [
    {
      "name": "SIGNUP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}
