{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1099-int-check",
  "compatibility_date": "2026-08-19",

  // Cloudflare Pages deploys one directory. `npm run build` composes it from
  // public/ (static) and src/index.js (server, copied in as _worker.js).
  // dist/ is generated — never edit it, never commit it.
  //
  // This is "advanced mode": because _worker.js exists at the root of the
  // build output, Pages routes EVERY request through it first and the script
  // reaches for static files itself via env.ASSETS.fetch(). That ordering is
  // the Pages default and it is what replaces the Workers-only
  // `assets.run_worker_first` flag: without worker-first ordering the page
  // ships with no security headers at all, which is silent and was verified
  // in production. Do not add a _routes.json excluding "/" — that would put
  // the asset server back in front and drop the headers again.
  "pages_build_output_dir": "./dist",

  // The project URL is not a secret; it ships in every Supabase client.
  // SUPABASE_PUBLISHABLE_KEY is set as a secret instead, so a public repo
  // does not hand strangers a way to POST straight into the table and
  // bypass this Worker's validation and honeypot:
  //   npx wrangler pages secret put SUPABASE_PUBLISHABLE_KEY
  "vars": {
    "SUPABASE_URL": "https://dorpekyszdlhvcozuocj.supabase.co",

    // ---- Walkthrough delivery -------------------------------------------
    //
    // Two providers are supported because they need different things, and
    // this site can only satisfy one of them.
    //
    //   brevo   verifies a single ADDRESS, by emailing it a confirmation
    //           link. No domain needed, so it works on pages.dev and can
    //           reach real visitors today. Free tier is ~300 emails/day.
    //             npx wrangler pages secret put BREVO_API_KEY --project-name 1099-int-check --env production
    //
    //   resend  verifies a DOMAIN, via SPF/DKIM/MX records in that domain's
    //           DNS zone. pages.dev is Cloudflare's zone, so this is
    //           impossible here until a domain is registered. Until then
    //           Resend sends only from onboarding@resend.dev and only TO the
    //           account owner — /api/status reports sandbox:true so that is
    //           never mistaken for working delivery. See GOING-LIVE.md.
    //
    // The provider is inferred from whichever key is set. Pin it explicitly
    // with WALKTHROUGH_PROVIDER ("brevo" or "resend") if both ever exist.
    //
    // Shown as the sender name. Without it, clients display the bare address,
    // which from a personal mailbox reads like mail from a stranger.
    "WALKTHROUGH_FROM_NAME": "1099-INT Check"

    // WALKTHROUGH_FROM and FOUNDER_BCC are deliberately NOT here. They are
    // set as secrets instead:
    //   npx wrangler pages secret put WALKTHROUGH_FROM --project-name 1099-int-check --env production
    //   npx wrangler pages secret put FOUNDER_BCC      --project-name 1099-int-check --env production
    //
    // Two reasons, neither about secrecy:
    //
    // 1. This repository is public. Both hold a personal mailbox address, and
    //    a plaintext address in a public repo is harvested. Nothing else here
    //    puts a real person's address in git and this should not start.
    //
    // 2. It removes a deploy cycle from the setup. Whoever configures
    //    delivery sets the key and the sender in the same place, with no code
    //    change and no pull request. A value in `vars` here would also become
    //    the source of truth and silently outrank anything set elsewhere.
    //
    // There is no default. An address that was never verified with the
    // provider means every send is rejected while /api/status still reports
    // delivery:true — the "looks configured, delivers nothing" failure this
    // project keeps finding. Absent is honest; wrong is not.
  }

  // NOT PRESENT, and deliberately so — these are Workers-only keys that
  // Pages silently ignores rather than rejects:
  //
  //   "ratelimits"    The SIGNUP_LIMITER binding. Pages Functions cannot bind
  //                   the rate limiter at all, so /api/signup no longer gets
  //                   an edge throttle. The limit that actually held was
  //                   always the Postgres trigger — Cloudflare documents the
  //                   edge binding as permissive and eventually consistent,
  //                   and it let 14 of 14 rapid writes through a 5/60 limit
  //                   in production. The database still enforces. src/index.js
  //                   logs on every signup that the binding is absent, which
  //                   is noisy on purpose: it should not be possible to forget
  //                   that a layer was removed.
  //
  //   "not_found_handling"  Pages has no equivalent knob. Unknown paths fall
  //                   through env.ASSETS.fetch() to Pages' own 404, which is
  //                   what "none" gave us. There is no 404.html in public/,
  //                   and adding an index.html fallback would resurrect the
  //                   old bug where every unknown path returned the landing
  //                   page with a 200.
  //
  //   "observability" Workers-only. Pages logs live under the project's
  //                   Functions tab; `npx wrangler pages deployment tail`
  //                   replaces `wrangler tail`.
}
